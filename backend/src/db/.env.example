# Environment configuration for KisaanCenter Database
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kisaan_center
DB_USER=kisaan_user
DB_PASSWORD=your_secure_password_here

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Database Query Timeouts (in milliseconds)
DB_STATEMENT_TIMEOUT=30000
DB_LOCK_TIMEOUT=10000

# SSL Configuration
DB_SSL_MODE=prefer

# Environment Settings
ENVIRONMENT=development

# Production Database Configuration (if different)
# PROD_DB_HOST=your-production-host
# PROD_DB_NAME=kisaan_center_prod
# PROD_DB_USER=kisaan_prod_user
# PROD_DB_PASSWORD=your_production_password

# Backup Configuration
BACKUP_LOCATION=./backups
BACKUP_RETENTION_DAYS=30

# Monitoring and Logging
LOG_LEVEL=INFO
DB_QUERY_LOG=false

# Security Settings
ENCRYPT_CONNECTION=true
VERIFY_SSL_CERT=true

# Performance Settings
ENABLE_QUERY_CACHE=true
MAX_CONNECTIONS_PER_POOL=100

# Development Settings (only for development environment)
DEV_SEED_DATA=false
DEV_AUTO_MIGRATE=true
DEV_RESET_ON_START=false
