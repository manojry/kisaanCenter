# Environment configuration for KisaanCenter Database
# Copy this file to .env and update with your actual values

# Database Configuration (Required)
DB_HOST=your_database_host_here
DB_PORT=5432
DB_NAME=your_database_name_here
DB_USER=your_database_username_here
DB_PASSWORD=your_database_password_here
DB_SSL_MODE=require

# Database Connection Pool Settings (Optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Database Query Timeouts (Optional) - in milliseconds
DB_STATEMENT_TIMEOUT=30000
DB_LOCK_TIMEOUT=10000

# Environment
ENVIRONMENT=development

# API Configuration (Required)
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Server Configuration (Optional)
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Application Settings (Optional)
APP_NAME=KisaanCenter Market Management System
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging (Optional)
LOG_LEVEL=INFO

# Example values for reference (DO NOT USE IN PRODUCTION):
# DB_HOST=localhost
# DB_NAME=kisaan_center
# DB_USER=kisaan_user
# DB_PASSWORD=your_secure_password
# SECRET_KEY=your-super-secret-key-for-jwt-signing
