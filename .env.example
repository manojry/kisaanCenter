# Environment configuration for KisaanCenter Database
# Copy this file to .env and update with your actual values

# Database Configuration (Required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kisaan_center
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL_MODE=require

# Database Connection Pool Settings (Optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Database Query Timeouts (Optional) - in milliseconds
DB_STATEMENT_TIMEOUT=30000
DB_LOCK_TIMEOUT=10000

# Environment
ENVIRONMENT=development

# API Configuration (Required)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Server Configuration (Optional)
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Application Settings (Optional)
APP_NAME=KisaanCenter Market Management System
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=KisaanCenter

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB

# Logging (Optional)
LOG_LEVEL=INFO

# Logging Configuration

# Example values for reference (DO NOT USE IN PRODUCTION):
# DB_HOST=localhost
# DB_NAME=kisaan_center
# DB_USER=kisaan_user
# DB_PASSWORD=your_secure_password
# SECRET_KEY=your-super-secret-key-for-jwt-signing
