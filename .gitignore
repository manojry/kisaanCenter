# ============================================
# TERRAFORM FILES (SENSITIVE & LARGE) - ALL LOCATIONS
# ============================================

# Terraform state files (SENSITIVE - contain passwords, keys, IPs)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files (SENSITIVE - may contain secrets)
*.tfvars
*.tfvars.json
terraform.tfvars
terraform.tfvars.json

# Terraform provider binaries (LARGE - auto-downloaded) - EVERYWHERE
.terraform/
*/.terraform/
**/.terraform/
terraform/*/.terraform/
terraform/**/.terraform/
.terraform.lock.hcl
*/.terraform.lock.hcl

# Terraform plan files (SENSITIVE - contain infrastructure details)
*.tfplan
*.tfplan.*

# Terraform crash logs
crash.log
crash.*.log

